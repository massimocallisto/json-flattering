MQTT_IN_BROKER=localhost
MQTT_IN_PORT=1883
# MQTT_IN_TRANSPORT can be either tcp | websockets
MQTT_IN_TRANSPORT=tcp
#MQTT_IN_USERNAME=
#MQTT_IN_PASSWORD=
MQTT_IN_TOPIC=/in/#
MQTT_OUT_BROKER=localhost
MQTT_OUT_PORT=1883
#MQTT_OUT_USER=
#MQTT_OUT_PASSWORD=
MQTT_OUT_TOPIC_PREFIX=/out
#THINGSBOARD_GW=false
#THINGSBOARD_GW_TOKEN =TOKEN
# LOG_LEVEL can be  INFO | DEBUG ...
LOG_LEVEL=INFO
